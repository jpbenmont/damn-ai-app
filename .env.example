# DAMN AI — Environment Variable Template
# Copy this file to `.env` and insert your own API keys locally.
# NEVER commit `.env` or `config.js` to version control.

# Server-side PHP proxy key (for Web PWA api.php)
GEMINI_API_KEY=your_gemini_api_key_here

# Expo Mobile App Runtime Keys (Expo SDK 52+ auto-loads EXPO_PUBLIC_* from .env)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:your_app_id_here
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
EXPO_PUBLIC_FIREBASE_DATABASE_ID=damn
